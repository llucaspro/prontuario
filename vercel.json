{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @workspace/api-server run build && pnpm --filter @workspace/pensare run build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "artifacts/pensare/dist/public",
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/[...path]" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/sign-in/:path*", "destination": "/index.html" },
    { "source": "/sign-up/:path*", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/patients", "destination": "/index.html" },
    { "source": "/patients/:id", "destination": "/index.html" },
    { "source": "/records", "destination": "/index.html" },
    { "source": "/agenda", "destination": "/index.html" },
    { "source": "/appointments", "destination": "/index.html" },
    { "source": "/reports", "destination": "/index.html" },
    { "source": "/documents", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" },
    { "source": "/security", "destination": "/index.html" }
  ]
}
